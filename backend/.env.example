# DB_ENGINE: "sqlite" (default), "postgres", or "local_postgres"
DB_ENGINE=sqlite

# Required only when DB_ENGINE=postgres.
# Any Postgres connection string works (Supabase, Xata, Neon, Railway...).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Used only when DB_ENGINE=local_postgres (a Postgres server on your machine/network).
# Each has a default if omitted (see settings.py) — override as needed.
DB_NAME=perle_db
DB_USER=test1
DB_PASSWORD=naumur
DB_HOST=localhost
DB_PORT=5432
